<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة توليد الأكواد الشاملة | CodeHub</title>
    <!-- استيراد خط تجريد/مظهر عصري -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <!-- مكتبة الأيقونات FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent-color: #6366f1;
            --accent-hover: #4f46e5;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #334155;
            --success-color: #22c55e;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
            margin-top: 20px;
        }

        header h1 {
            font-size: 2.5rem;
            font-weight: 900;
            background: linear-gradient(45deg, #6366f1, #a855f7, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        header p {
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        .container {
            width: 100%;
            max-width: 800px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .tab-btn {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .tab-btn.active, .tab-btn:hover {
            background: var(--accent-color);
            color: white;
            border-color: var(--accent-color);
        }

        .generator-section {
            display: none;
        }

        .generator-section.active {
            display: block;
            animation: fadeIn 0.4s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--text-main);
        }

        .form-control, select {
            width: 100%;
            padding: 12px 15px;
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: white;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.3s;
        }

        .form-control:focus, select:focus {
            border-color: var(--accent-color);
        }

        .checkbox-group {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: var(--text-muted);
            user-select: none;
        }

        .checkbox-label input {
            accent-color: var(--accent-color);
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .btn-generate {
            width: 100%;
            background: var(--accent-color);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 25px;
        }

        .btn-generate:hover {
            background: var(--accent-hover);
        }

        .output-box {
            position: relative;
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 15px;
            min-height: 100px;
            max-height: 200px;
            overflow-y: auto;
            word-break: break-all;
            font-family: monospace;
            font-size: 1rem;
            color: #38bdf8;
        }

        .output-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .output-header span {
            font-size: 0.9rem;
            color: var(--text-muted);
            font-weight: 600;
        }

        .btn-copy {
            background: var(--border-color);
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: background 0.2s;
        }

        .btn-copy:hover {
            background: var(--success-color);
        }

        footer {
            margin-top: 40px;
            color: var(--text-muted);
            font-size: 0.9rem;
            text-align: center;
        }
    </style>
</head>
<body>

    <header>
        <h1>CodeHub Generator</h1>
        <p>منصة متكاملة لتوليد الأكواد، كلمات السر، والرموز البرمجية بضغطة زر واحدة</p>
    </header>

    <div class="container">
        <!-- أزرار التنقل بين الأقسام (Tabs) -->
        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('passwords', event)"><i class="fa-solid fa-key"></i> كلمات السر</button>
            <button class="tab-btn" onclick="switchTab('promo', event)"><i class="fa-solid fa-ticket"></i> أكواد خصم</button>
            <button class="tab-btn" onclick="switchTab('uuid', event)"><i class="fa-solid fa-fingerprint"></i> معرفات UUID</button>
            <button class="tab-btn" onclick="switchTab('randomtext', event)"><i class="fa-solid fa-file-lines"></i> نص عشوائي</button>
        </div>

        <!-- 1. قسم توليد كلمات السر -->
        <div id="passwords" class="generator-section active">
            <div class="form-group">
                <label>طول كلمة السر: <span id="passLenVal">16</span></label>
                <input type="range" id="passLen" min="6" max="64" value="16" class="form-control" oninput="document.getElementById('passLenVal').innerText = this.value">
            </div>
            <div class="checkbox-group">
                <label class="checkbox-label"><input type="checkbox" id="incUpper" checked> أحرف كبيرة (A-Z)</label>
                <label class="checkbox-label"><input type="checkbox" id="incLower" checked> أحرف صغيرة (a-z)</label>
                <label class="checkbox-label"><input type="checkbox" id="incNums" checked> أرقام (0-9)</label>
                <label class="checkbox-label"><input type="checkbox" id="incSyms" checked> رموز خاصة (!@#$)</label>
            </div>
            <button class="btn-generate" onclick="generatePasswords()"><i class="fa-solid fa-wand-magic-sparkles"></i> توليد كلمات السر</button>
            
            <div class="output-header">
                <span>النتائج المולدة:</span>
                <button class="btn-copy" onclick="copyOutput('passOutput')"><i class="fa-regular fa-copy"></i> نسخ الكل</button>
            </div>
            <div id="passOutput" class="output-box">اضغط على زر التوليد للبدء...</div>
        </div>

        <!-- 2. قسم توليد أكواد الخصم / التفعيل -->
        <div id="promo" class="generator-section">
            <div class="form-group">
                <label>بادئة الكود (Prefix):</label>
                <input type="text" id="promoPrefix" class="form-control" value="PROMO-" placeholder="مثال: SALE2026-">
            </div>
            <div class="form-group">
                <label>عدد الأكواد المراد توليدها:</label>
                <input type="number" id="promoCount" class="form-control" value="5" min="1" max="50">
            </div>
            <button class="btn-generate" onclick="generatePromoCodes()"><i class="fa-solid fa-wand-magic-sparkles"></i> توليد أكواد الخصم</button>
            
            <div class="output-header">
                <span>الأكواد المולدة:</span>
                <button class="btn-copy" onclick="copyOutput('promoOutput')"><i class="fa-regular fa-copy"></i> نسخ الكل</button>
            </div>
            <div id="promoOutput" class="output-box">اضغط على زر التوليد للبدء...</div>
        </div>

        <!-- 3. قسم توليد UUID -->
        <div id="uuid" class="generator-section">
            <div class="form-group">
                <label>عدد المعرفات المطلوبة:</label>
                <input type="number" id="uuidCount" class="form-control" value="3" min="1" max="20">
            </div>
            <button class="btn-generate" onclick="generateUUIDs()"><i class="fa-solid fa-wand-magic-sparkles"></i> توليد المعرفات الفريدة</button>
            
            <div class="output-header">
                <span>المعرفات (UUID v4):</span>
                <button class="btn-copy" onclick="copyOutput('uuidOutput')"><i class="fa-regular fa-copy"></i> نسخ الكل</button>
            </div>
            <div id="uuidOutput" class="output-box">اضغط على زر التوليد للبدء...</div>
        </div>

        <!-- 4. قسم توليد نصوص عشوائية -->
        <div id="randomtext" class="generator-section">
            <div class="form-group">
                <label>نوع النص العشوائي:</label>
                <select id="textType" class="form-control">
                    <option value="hex">أكواد سداسية عشرية (Hex)</option>
                    <option value="alpha">أحرف عشوائية بحتة</option>
                    <option value="slug">مسار رابط (Slug)</option>
                </select>
            </div>
            <div class="form-group">
                <label>الطول:</label>
                <input type="number" id="textLength" class="form-control" value="20" min="5" max="100">
            </div>
            <button class="btn-generate" onclick="generateRandomText()"><i class="fa-solid fa-wand-magic-sparkles"></i> توليد النص</button>
            
            <div class="output-header">
                <span>النص الناتج:</span>
                <button class="btn-copy" onclick="copyOutput('textOutput')"><i class="fa-regular fa-copy"></i> نسخ النص</button>
            </div>
            <div id="textOutput" class="output-box">اضغط على زر التوليد للبدء...</div>
        </div>

    </div>

    <footer>
        <p>جميع الحقوق محفوظة &copy; CodeHub 2026</p>
    </footer>

    <script>
        // التبديل بين الأقسام
        function switchTab(tabId, event) {
            document.querySelectorAll('.generator-section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        // نسخ المحتوى للحافظة
        function copyOutput(elementId) {
            const text = document.getElementById(elementId).innerText;
            if (text.includes("اضغط على زر التوليد") || text.trim() === "") return;
            
            navigator.clipboard.writeText(text).then(() => {
                alert("تم نسخ المحتوى إلى الحافظة بنجاح!");
            });
        }

        // 1. منطق توليد كلمات السر
        function generatePasswords() {
            const length = document.getElementById('passLen').value;
            const upper = document.getElementById('incUpper').checked;
            const lower = document.getElementById('incLower').checked;
            const nums = document.getElementById('incNums').checked;
            const syms = document.getElementById('incSyms').checked;

            let chars = "";
            if (upper) chars += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            if (lower) chars += "abcdefghijklmnopqrstuvwxyz";
            if (nums) chars += "0123456789";
            if (syms) chars += "!@#$%^&*()_+-=[]{}|;:,.<>?";

            if (chars === "") {
                document.getElementById('passOutput').innerText = "الرجاء اختيار خيار واحد على الأقل!";
                return;
            }

            let result = "";
            for (let i = 0; i < 5; i++) { // توليد 5 خيارات في كل مرة
                let pass = "";
                for (let j = 0; j < length; j++) {
                    pass += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                result += pass + "\n";
            }
            document.getElementById('passOutput').innerText = result.trim();
        }

        // 2. منطق توليد أكواد الخصم
        function generatePromoCodes() {
            const prefix = document.getElementById('promoPrefix').value;
            const count = parseInt(document.getElementById('promoCount').value) || 5;
            const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
            
            let result = "";
            for (let i = 0; i < count; i++) {
                let codePart = "";
                for (let j = 0; j < 8; j++) {
                    codePart += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                result += prefix + codePart + "\n";
            }
            document.getElementById('promoOutput').innerText = result.trim();
        }

        // 3. منطق توليد UUID v4
        function generateUUIDs() {
            const count = parseInt(document.getElementById('uuidCount').value) || 3;
            let result = "";
            
            for (let i = 0; i < count; i++) {
                let uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                    let r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
                result += uuid + "\n";
            }
            document.getElementById('uuidOutput').innerText = result.trim();
        }

        // 4. منطق توليد نص عشوائي
        function generateRandomText() {
            const type = document.getElementById('textType').value;
            const length = parseInt(document.getElementById('textLength').value) || 20;
            let chars = "";

            if (type === 'hex') chars = "0123456789abcdef";
            else if (type === 'alpha') chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
            else if (type === 'slug') chars = "abcdefghijklmnopqrstuvwxyz0123456789-_";

            let result = "";
            for (let i = 0; i < length; i++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('textOutput').innerText = result;
        }
    </script>
</body>
</html>
